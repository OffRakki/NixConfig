             delegate: ColumnLayout {
               Layout.fillWidth: true
               spacing: Style.marginS
@@ -242,7 +242,7 @@
                 spacing: Style.marginS
 
                 NIcon {
-                  icon: BluetoothService.getDeviceIcon(modelData)

diff --git a/Modules/Panels/Battery/BatteryPanel.qml b/Modules/Panels/Battery/BatteryPanel.qml
--- a/Modules/Panels/Battery/BatteryPanel.qml
+++ b/Modules/Panels/Battery/BatteryPanel.qml
@@ -121,7 +121,7 @@
       NBox {
         Layout.fillWidth: true
         implicitHeight: chargeLayout.implicitHeight + Style.margin2L
-        visible: BatteryService.laptopBatteries.length > 0 || BatteryService.bluetoothBatteries.length > 0
+        visible: BatteryService.laptopBatteries.length > 0 || BatteryService.externalBatteries.length > 0
 
         ColumnLayout {
           id: chargeLayout
@@ -228,12 +228,12 @@
 
           NDivider {
             Layout.fillWidth: true
-            visible: BatteryService.laptopBatteries.length > 0 && BatteryService.bluetoothBatteries.length > 0

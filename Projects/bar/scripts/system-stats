#!/bin/sh

read_cpu() {
    set -- $(head -n 1 /proc/stat)
    idle=$(( $5 + $6 ))
    total=0
    shift
    for value in "$@"; do total=$((total + value)); done
    printf '%s %s\n' "$idle" "$total"
}

read_net() {
    awk -F '[: ]+' 'NR > 2 && $2 != "lo" { rx += $3; tx += $11 } END { printf "%.0f %.0f\n", rx, tx }' /proc/net/dev
}

set -- $(read_cpu); previous_idle=$1; previous_total=$2
set -- $(read_net); previous_rx=$1; previous_tx=$2

while sleep 2; do
    set -- $(read_cpu); idle=$1; total=$2
    delta_idle=$((idle - previous_idle)); delta_total=$((total - previous_total))
    if [ "$delta_total" -gt 0 ]; then
        cpu=$(awk -v idle="$delta_idle" -v total="$delta_total" 'BEGIN { printf "%.0f", 100 * (1 - idle / total) }')
    else
        cpu=0
    fi
    previous_idle=$idle; previous_total=$total

    memory=$(awk '/MemTotal:/ { total=$2 } /MemAvailable:/ { available=$2 } END { printf "%.0f", 100 * (total - available) / total }' /proc/meminfo)

    temperature=0
    for sensor in /sys/class/thermal/thermal_zone*/temp /sys/class/hwmon/hwmon*/temp*_input; do
        [ -r "$sensor" ] || continue
        value=$(cat "$sensor")
        [ "$value" -gt 1000 ] && value=$((value / 1000))
        [ "$value" -gt "$temperature" ] && [ "$value" -lt 150 ] && temperature=$value
    done

    set -- $(read_net); rx=$1; tx=$2
    download=$(((rx - previous_rx) / 2)); upload=$(((tx - previous_tx) / 2))
    [ "$download" -lt 0 ] && download=0
    [ "$upload" -lt 0 ] && upload=0
    previous_rx=$rx; previous_tx=$tx

    printf '%s\t%s\t%s\t%s\t%s\n' "$cpu" "$memory" "$temperature" "$download" "$upload"
done
